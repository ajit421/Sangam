---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { langs, langPath, langLabel, t, type Lang } from '../i18n';
import { shop, reviews } from '../data/shop';
import { loadProducts } from '../lib/products';
import shopFront from '../assets/photos/shop-front.jpg';
import shopStreet from '../assets/photos/shop-street.jpg';
import berger from '../assets/photos/berger-machine.jpg';
import insideAisle from '../assets/photos/inside-aisle.jpg';

const { lang } = Astro.props as { lang: Lang };
const d = t[lang];
const products = await loadProducts();
const name = (p: { name_hi: string; name_en: string }) => (lang === 'en' ? p.name_en : p.name_hi);
const inr = (n: number) => n.toLocaleString('en-IN');
const unit = (u: string) => d.units[u as keyof typeof d.units] ?? u;
const priceText = (p: (typeof products)[number]) => (p.price ? `${d.from(inr(p.price))} / ${unit(p.unit)}` : d.ask);

// Category photo: drop <category>.jpg/.png/.webp into src/assets/categories and it replaces the icon tile.
const catImages = import.meta.glob<{ default: ImageMetadata }>('../assets/categories/*.{jpg,jpeg,png,webp}', { eager: true });
const catImg = (c: string) => Object.entries(catImages).find(([p]) => p.split('/').pop()!.split('.')[0] === c)?.[1].default;
const catIcon: Record<string, string> = { pipes: 'spline', tanks: 'cylinder', pumps: 'cog', sanitary: 'bath', taps: 'shower-head', tiles: 'layout-grid', paints: 'paint-roller' };
const groups = (Object.keys(d.cats) as (keyof typeof d.cats)[])
  .map((c) => ({ c, img: catImg(c), items: products.filter((p) => p.category === c) }))
  .filter((g) => g.items.length);

const swatchHex = ['#E8772E', '#F2C230', '#7FC3E0', '#5B9A3C', '#E57FA4', '#B3261E', '#F1E3BF', '#8D96A0'];
const owner = lang === 'en' ? shop.owner.en : shop.owner.hi;
const tel = 'tel:+91' + shop.phones[0];
const wa = `https://wa.me/${shop.whatsapp}?text=${encodeURIComponent(d.order.msg.split(',')[0] + ' 🙏')}`;
const addr = lang === 'en'
  ? `${shop.address.street}, ${shop.address.locality}, ${shop.address.district}, ${shop.address.region} ${shop.address.pin}`
  : `${shop.address.streetHi}, ${shop.address.localityHi}, ${shop.address.districtHi}, ${shop.address.regionHi} ${shop.address.pin}`;
const facts = [
  [`${shop.yearsTrust}+`, d.stats.years, 'store'],
  [`${shop.rating.value.toFixed(1)} ★`, `${d.stats.rating} · ${shop.rating.count}`, 'star'],
  [`${shop.deliveryKm} km`, d.stats.km, 'truck'],
  [d.pay, d.services[5][2], 'qr-code'],
];

const eyebrow = 'text-sm font-semibold tracking-[0.14em] uppercase';
const btn = 'inline-flex min-h-12 items-center justify-center gap-2 rounded-xl px-5 py-3 text-lg font-semibold transition duration-200 active:scale-[0.97]';
const [openH, closeH] = [shop.hours.open, shop.hours.close].map((h) => parseInt(h, 10));
---
<a href="#main" class="sr-only z-50 rounded-lg bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:left-3 focus:top-3">{d.skip}</a>

<!-- Top strip: live open/closed status (filled in by script; plain hours without JS) -->
<div class="bg-ink text-sm text-paper">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-1 px-4 py-2">
    <p data-status data-open-h={openH} data-close-h={closeH} data-open={d.topOpen} data-closed={d.topClosed} data-until={d.topUntil} data-opens={d.topOpens}
       class="flex items-center gap-2">
      <span data-dot class="size-2.5 rounded-full bg-stone-400" aria-hidden="true"></span>
      <span data-status-text>{d.hours}</span>
    </p>
    <p class="ml-auto hidden items-center gap-1.5 text-paper/80 sm:flex"><Icon name="map-pin" class="size-4" />{d.place}</p>
    <a href={tel} class="hidden items-center gap-1.5 py-1 font-semibold hover:text-marigold sm:flex"><Icon name="phone" class="size-4" />{shop.phones[0]}</a>
    <!-- Phones: language switch lives here, the header has no room for it -->
    <nav aria-label="Language" class="ml-auto flex sm:hidden">
      {langs.map((l) => (
        <a href={langPath[l]} hreflang={l} aria-current={l === lang ? 'page' : undefined}
           class:list={['px-2 py-1.5', l === lang ? 'font-semibold text-marigold underline underline-offset-4' : 'text-paper/80']}>{langLabel[l]}</a>
      ))}
    </nav>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-2.5">
    <a href={langPath[lang]} class="flex items-center gap-2.5 rounded-lg">
      <img src="/logo.svg" alt="" width="42" height="42" class="size-10 sm:size-11" />
      <span class="whitespace-nowrap leading-none">
        <span class="block font-display text-xl font-bold text-brick sm:text-2xl">{shop.nameHi}</span>
        <span class="mt-0.5 block text-[10px] font-semibold tracking-[0.22em] text-ink-soft">SANGAM HARDWARE</span>
      </span>
    </a>
    <nav aria-label="Sections" class="ml-6 hidden gap-6 font-medium text-ink-soft lg:flex">
      <a href="#products" class="py-2 hover:text-brick">{d.nav.products}</a>
      <a href="#services" class="py-2 hover:text-brick">{d.nav.services}</a>
      <a href="#about" class="py-2 hover:text-brick">{d.nav.about}</a>
      <a href="#contact" class="py-2 hover:text-brick">{d.nav.contact}</a>
    </nav>
    <div class="ml-auto flex items-center gap-4">
      <nav aria-label="Language" class="hidden items-center text-[15px] sm:flex">
        {langs.map((l, i) => (
          <>
            {i > 0 && <span class="px-0.5 text-line" aria-hidden="true">/</span>}
            <a href={langPath[l]} hreflang={l} aria-current={l === lang ? 'page' : undefined}
               class:list={['px-1.5 py-2', l === lang ? 'font-semibold text-brick underline decoration-2 underline-offset-[6px]' : 'text-ink-soft hover:text-ink']}>{langLabel[l]}</a>
          </>
        ))}
      </nav>
      <a href={tel} class="hidden min-h-12 items-center gap-2 rounded-xl bg-brick px-5 py-3 font-semibold text-white transition hover:bg-brick-dark md:inline-flex"><Icon name="phone" />{d.call}</a>
    </div>
  </div>
</header>

<main id="main" class="pb-20 md:pb-0">
  <!-- HERO -->
  <section>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 pb-16 pt-10 md:grid-cols-[1.15fr_1fr] md:items-center md:pb-24 md:pt-16">
      <div>
        <p class="flex items-center gap-1.5 font-semibold text-brick"><Icon name="map-pin" class="size-4" />{d.place}</p>
        <h1 class="mt-3 text-[2.4rem] font-bold md:text-[3.6rem]">{d.heroTitle}</h1>
        <p class="mt-5 max-w-xl text-lg text-ink-soft md:text-xl">{d.heroSub}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={tel} class={`${btn} bg-brick text-white shadow-[0_3px_0_var(--color-brick-dark)] hover:bg-brick-dark`}><Icon name="phone" />{d.call}</a>
          <a href={wa} class={`${btn} border-2 border-leaf bg-white text-leaf hover:bg-leaf hover:text-white`}><Icon name="message-circle" />{d.whatsapp}</a>
        </div>
        <a href={shop.directionsUrl} class="mt-5 inline-flex items-center gap-1.5 py-1 font-semibold text-indigo underline decoration-indigo/30 decoration-2 underline-offset-4 hover:decoration-indigo">
          <Icon name="navigation" class="size-4" />{d.directions}
        </a>
      </div>
      <figure class="relative mr-3 mt-3 md:mr-6">
        <div aria-hidden="true" class="absolute inset-0 translate-x-3 -translate-y-3 rounded-[28px] bg-marigold md:translate-x-6 md:-translate-y-6"></div>
        <Image src={shopFront} alt={`${shop.nameHi}, ${shop.address.localityHi}`} widths={[400, 700]} sizes="(min-width: 768px) 480px, 90vw"
          loading="eager" fetchpriority="high" class="relative aspect-[4/3] w-full rounded-[28px] object-cover" />
        <figcaption class="absolute -bottom-6 left-4 rounded-xl bg-white px-4 py-3 shadow-lg ring-1 ring-line">
          <span class="block text-xs font-semibold tracking-wide text-ink-soft">{d.ownerLabel}</span>
          <span class="block font-display text-lg font-bold">{owner}</span>
        </figcaption>
      </figure>
    </div>

    <!-- Facts ledger -->
    <div class="border-y border-line bg-white">
      <div class="mx-auto grid max-w-6xl grid-cols-2 md:grid-cols-4">
        {facts.map(([v, l, ic], i) => (
          <div class:list={['flex items-center gap-3 border-line px-4 py-5', i % 2 === 0 && 'border-r', i < 2 && 'border-b md:border-b-0', i === 1 && 'md:border-r']}>
            <span class="hidden size-10 shrink-0 place-items-center rounded-full bg-paper-2 text-brick sm:grid"><Icon name={ic} /></span>
            <div class="flex min-w-0 flex-col-reverse">
              <p class="text-sm leading-snug text-ink-soft">{l}</p>
              <p class="font-display text-xl font-bold leading-tight md:text-2xl">{v}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRANDS -->
  <section class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-8 gap-y-3 px-4 py-8">
    <h2 class="font-sans text-sm font-semibold text-ink-soft">{d.brandsTitle}</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-1 font-display text-lg font-bold text-ink/75">
      {shop.brands.map((b) => <li>{b}</li>)}
    </ul>
  </section>

  <!-- PRODUCTS: printed-rate-list style -->
  <section id="products" class="border-t border-line bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
      <p class={`${eyebrow} text-brick`}>{d.rateEyebrow}</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-5">
        <h2 class="text-4xl font-bold md:text-5xl">{d.productsTitle}</h2>
        <p class="flex max-w-md items-start gap-2.5 rounded-xl bg-marigold-soft px-4 py-3 text-[15px] leading-snug">
          <Icon name="star" class="mt-0.5 size-4 fill-current text-brick" />{d.productsSub}
        </p>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[220px_1fr]">
        <div role="group" aria-label={d.productsTitle} class="flex flex-wrap gap-2 lg:sticky lg:top-24 lg:flex-col lg:self-start">
          {[{ c: 'all', label: d.all, icon: 'layout-grid', n: products.length }, ...groups.map((g) => ({ c: g.c, label: d.cats[g.c], icon: catIcon[g.c], n: g.items.length }))].map((f, i) => (
            <button data-filter={f.c} aria-pressed={i === 0 ? 'true' : 'false'}
              class="flex min-h-11 items-center gap-2 rounded-full border border-line bg-paper px-4 py-2 font-medium transition-colors hover:border-ink/40 aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper lg:rounded-xl">
              <Icon name={f.icon} class="size-4" />
              <span>{f.label}</span>
              <span class="ml-auto pl-1 text-sm tabular-nums opacity-70">{f.n}</span>
            </button>
          ))}
        </div>

        <div class="space-y-12">
          {groups.map((g) => (
            <section data-cat={g.c} aria-labelledby={`cat-${g.c}`}>
              <div class="flex items-center gap-4 border-b-2 border-ink pb-3">
                {g.img
                  ? <Image src={g.img} alt="" width={120} height={120} class="size-14 rounded-xl object-cover" />
                  : <span class="grid size-14 place-items-center rounded-xl bg-paper-2 text-brick"><Icon name={catIcon[g.c]} class="size-7" /></span>}
                <h3 id={`cat-${g.c}`} class="text-2xl font-bold md:text-3xl">{d.cats[g.c]}</h3>
              </div>
              <ul class="divide-y divide-line">
                {g.items.map((p) => (
                  <li class="flex items-center gap-3 py-3.5">
                    <div class="min-w-0 flex-1">
                      <div class="flex items-baseline gap-2">
                        <span class="text-lg font-semibold leading-snug">{name(p)}</span>
                        <span class="leader hidden sm:block" aria-hidden="true"></span>
                        <span class="hidden whitespace-nowrap font-bold tabular-nums text-brick sm:block">{priceText(p)}</span>
                      </div>
                      <p class="text-[15px] text-ink-soft">
                        <span class="font-bold tabular-nums text-brick sm:hidden">{priceText(p)}</span>
                        {p.brand && <span class="before:mx-1.5 before:content-['·'] sm:before:hidden">{p.brand}</span>}
                      </p>
                    </div>
                    <button data-add={name(p)} aria-label={`${d.add}: ${name(p)}`}
                      class="grid size-11 shrink-0 place-items-center rounded-full border-2 border-indigo text-indigo transition-colors hover:bg-indigo hover:text-white">
                      <span data-i="plus"><Icon name="plus" /></span>
                      <span data-i="check" hidden><Icon name="check" /></span>
                    </button>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- COLOUR MACHINE + interactive wall preview -->
  <section class="bg-paper-2">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:gap-14 md:py-20">
      <Image src={berger} alt="Berger ColorBank" widths={[400, 700]} sizes="(min-width: 768px) 520px, 92vw"
        class="reveal aspect-[4/3] w-full rounded-[24px] object-cover md:aspect-[4/5]" />
      <div>
        <p class={`${eyebrow} text-brick`}>Berger ColorBank</p>
        <h2 class="mt-2 text-4xl font-bold md:text-5xl">{d.colorTitle}</h2>
        <p class="mt-4 text-lg text-ink-soft">{d.colorText}</p>

        <div class="mt-8 overflow-hidden rounded-2xl bg-white ring-1 ring-line">
          <div data-wall class="relative aspect-[16/7] transition-colors duration-500" style={`background:${swatchHex[0]}`}>
            <!-- simple house front: two windows and a door -->
            <svg viewBox="0 0 320 140" class="absolute inset-0 size-full" aria-hidden="true" fill="none" stroke="#fff" stroke-width="3" stroke-opacity=".85">
              <rect x="40" y="40" width="56" height="44" rx="3" /><path d="M68 40v44M40 62h56" />
              <rect x="224" y="40" width="56" height="44" rx="3" /><path d="M252 40v44M224 62h56" />
              <path d="M136 140V64a24 24 0 0 1 48 0v76" /><circle cx="174" cy="104" r="3" fill="#fff" />
            </svg>
          </div>
          <div class="flex items-center justify-between gap-3 px-4 py-3">
            <span class="text-sm text-ink-soft">{d.wall}</span>
            <span data-wall-name class="font-display text-lg font-bold" aria-live="polite">{d.swatches[0]}</span>
          </div>
        </div>
        <p class="mt-5 text-sm font-semibold text-ink-soft">{d.swatchHint}</p>
        <div role="group" aria-label={d.swatchHint} class="mt-3 flex flex-wrap gap-2.5">
          {swatchHex.map((hex, i) => (
            <button data-swatch={hex} data-name={d.swatches[i]} aria-label={d.swatches[i]} aria-pressed={i === 0 ? 'true' : 'false'}
              class="size-11 rounded-full ring-1 ring-black/15 transition-transform hover:scale-110 aria-pressed:ring-[3px] aria-pressed:ring-ink aria-pressed:ring-offset-2 aria-pressed:ring-offset-paper-2"
              style={`background:${hex}`}></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_1.8fr] md:gap-14">
      <div>
        <p class={`${eyebrow} text-brick`}>{d.nav.services}</p>
        <h2 class="mt-2 text-4xl font-bold md:text-5xl">{d.servicesTitle}</h2>
        <Image src={insideAisle} alt="" widths={[360, 540]} sizes="360px" class="mt-8 hidden aspect-[4/5] w-full rounded-[24px] object-cover md:block" />
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {d.services.map(([icon, title, text]) => (
          <li class="reveal flex gap-4 border-t border-line py-6">
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brick/10 text-brick"><Icon name={icon} class="size-6" /></span>
            <div>
              <h3 class="font-sans text-xl font-bold">{title}</h3>
              <p class="mt-1 text-ink-soft">{text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- STORY -->
  <section id="about" class="bg-indigo text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 md:grid-cols-2 md:py-20">
      <div>
        <p class={`${eyebrow} text-marigold`}>{d.storyEyebrow}</p>
        <h2 class="mt-2 text-4xl font-bold md:text-5xl">{d.aboutTitle}</h2>
        <p class="mt-4 text-lg text-blue-100">{d.aboutText}</p>
        <ol class="mt-8 space-y-7 border-l-2 border-white/25 pl-7">
          {d.story.map(([when, title, text]) => (
            <li class="relative">
              <span class="absolute -left-[37px] top-1.5 size-4 rounded-full bg-marigold ring-4 ring-indigo" aria-hidden="true"></span>
              <p class="text-sm font-semibold text-marigold">{when}</p>
              <h3 class="mt-0.5 text-2xl font-bold">{title}</h3>
              <p class="mt-1 text-blue-100">{text}</p>
            </li>
          ))}
        </ol>
        <p class="mt-8 border-t border-white/20 pt-5 text-blue-100">{d.ownerLabel}: <strong class="font-display text-xl text-white">{owner}</strong></p>
      </div>
      <Image src={shopStreet} alt={`${shop.nameHi}, ${shop.address.localityHi}`} widths={[400, 700]} sizes="(min-width: 768px) 520px, 92vw"
        class="reveal aspect-[4/5] w-full rounded-[24px] object-cover" />
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="text-4xl font-bold md:text-5xl">{d.reviewsTitle}</h2>
        <div class="mt-6 flex items-end gap-4">
          <span class="font-display text-7xl font-bold leading-none">{shop.rating.value.toFixed(1)}</span>
          <div class="pb-1">
            <div class="flex text-marigold" role="img" aria-label={`${shop.rating.value} / 5`}>
              {[1, 2, 3, 4, 5].map(() => <Icon name="star" class="size-5 fill-current" />)}
            </div>
            <p class="text-ink-soft">{shop.rating.count} Google reviews</p>
          </div>
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={shop.mapsUrl} class={`${btn} bg-marigold text-base text-ink hover:brightness-95`}><Icon name="star" />{d.writeReview}</a>
          <a href={shop.mapsUrl} class="inline-flex min-h-12 items-center gap-1.5 px-1 font-semibold text-indigo underline decoration-indigo/30 decoration-2 underline-offset-4 hover:decoration-indigo">{d.seeAll}<Icon name="arrow-right" class="size-4" /></a>
        </div>
      </div>
      <ul class="columns-1 gap-5 sm:columns-2">
        {reviews.map((r) => (
          <li class="reveal mb-5 break-inside-avoid rounded-2xl bg-white p-5 ring-1 ring-line">
            <blockquote class="text-lg leading-relaxed">“{lang === 'en' ? r.en : r.hi}”</blockquote>
            <p class="mt-4 flex items-center gap-3">
              <span class="grid size-10 place-items-center rounded-full bg-paper-2 font-display font-bold text-brick" aria-hidden="true">{r.name[0].toUpperCase()}</span>
              <span><span class="block font-semibold capitalize">{r.name.toLowerCase()}</span><span class="text-sm text-ink-soft">{d.reviewNote}</span></span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line bg-white">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-[1fr_1.8fr] md:gap-14 md:py-20">
      <h2 class="text-4xl font-bold md:text-5xl">{d.faqTitle}</h2>
      <div class="divide-y divide-line border-y border-line">
        {d.faq.map(([q, a]) => (
          <details class="group">
            <summary class="flex min-h-14 list-none items-center justify-between gap-4 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-paper-2 text-brick transition-transform duration-200 group-open:rotate-45"><Icon name="plus" class="size-4" /></span>
            </summary>
            <p class="pb-5 pr-10 text-ink-soft">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- VISIT -->
  <section id="contact" class="bg-ink text-paper">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-14 md:grid-cols-2 md:py-20">
      <div>
        <h2 class="text-4xl font-bold md:text-5xl">{d.contactTitle}</h2>
        <div class="mt-8 space-y-6">
          <div class="flex gap-4"><Icon name="clock" class="mt-1 size-6 text-marigold" />
            <div><p class="text-sm text-paper/70">{d.hoursLabel}</p><p class="text-lg font-semibold">{d.hours}</p><p class="mt-1 text-paper/80">{d.night}</p></div></div>
          <div class="flex gap-4"><Icon name="map-pin" class="mt-1 size-6 text-marigold" />
            <div><p class="text-sm text-paper/70">{d.addressLabel}</p><p class="text-lg">{addr}</p></div></div>
          <div class="flex gap-4"><Icon name="phone" class="mt-1 size-6 text-marigold" />
            <div><p class="text-sm text-paper/70">{d.phoneLabel}</p>
              <p class="flex flex-wrap gap-x-6">{shop.phones.map((p) => <a href={`tel:+91${p}`} class="py-1 font-display text-2xl font-bold tabular-nums hover:text-marigold">{p.slice(0, 5)} {p.slice(5)}</a>)}</p></div></div>
          <div class="flex gap-4"><Icon name="truck" class="mt-1 size-6 text-marigold" />
            <div><p class="text-sm text-paper/70">{d.areaLabel}</p><p class="text-lg">{(lang === 'en' ? shop.areas : shop.areasHi).join(', ')} · {shop.deliveryKm} km</p></div></div>
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={tel} class={`${btn} bg-brick text-white hover:bg-brick-dark`}><Icon name="phone" />{d.call}</a>
          <a href={wa} class={`${btn} bg-leaf text-white hover:brightness-110`}><Icon name="message-circle" />WhatsApp</a>
          <a href={shop.directionsUrl} class={`${btn} border-2 border-paper/40 text-paper hover:border-paper`}><Icon name="navigation" />{d.directions}</a>
        </div>
      </div>
      <iframe src={shop.mapEmbed} title={`${shop.name} – Google Maps`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"
        class="h-80 w-full rounded-[24px] border-0 md:h-full md:min-h-[28rem]"></iframe>
    </div>
  </section>
</main>

<footer class="border-t border-white/10 bg-ink pb-24 pt-8 text-paper/70 md:pb-8">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4">
    <p class="flex items-center gap-3"><img src="/logo.svg" alt="" width="32" height="32" class="size-8" /><span><span class="font-display font-bold text-paper">{shop.nameHi}</span> · {d.footer}</span></p>
    <nav aria-label="Language" class="flex gap-4 text-sm">{langs.map((l) => <a href={langPath[l]} class="py-2 hover:text-paper">{langLabel[l]}</a>)}</nav>
  </div>
</footer>

<!-- Mobile action bar -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-white text-center text-[13px] font-semibold md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
  <a href={tel} class="flex flex-col items-center gap-0.5 py-2.5 text-brick"><Icon name="phone" class="size-6" />{d.call}</a>
  <a href={wa} class="flex flex-col items-center gap-0.5 bg-leaf py-2.5 text-white"><Icon name="message-circle" class="size-6" />WhatsApp</a>
  <button data-open-cart class="flex flex-col items-center gap-0.5 py-2.5 text-indigo">
    <span class="relative"><Icon name="shopping-bag" class="size-6" /><span data-count data-badge hidden class="absolute -right-2.5 -top-1.5 min-w-5 rounded-full bg-brick px-1 text-[11px] leading-5 text-white">0</span></span>
    {d.order.view}
  </button>
</div>

<!-- Desktop order button, shown once something is added -->
<button data-open-cart data-cart-fab hidden class="fixed bottom-6 right-6 z-40 hidden items-center gap-2 rounded-full bg-indigo px-5 py-3.5 text-lg font-semibold text-white shadow-xl transition hover:brightness-110 md:flex">
  <Icon name="shopping-bag" />{d.order.view} <span data-count class="rounded-full bg-white/20 px-2 text-base tabular-nums">0</span>
</button>
<p data-live class="sr-only" aria-live="polite" data-items-label={d.order.items}></p>

<dialog id="cart" data-wa={shop.whatsapp} data-msg={d.order.msg} data-msg-name={d.order.msgName} data-msg-village={d.order.msgVillage}
  class="sheet mb-0 mt-auto w-full max-w-none rounded-t-3xl bg-paper p-0 text-ink shadow-2xl backdrop:bg-ink/60 sm:m-auto sm:w-[30rem] sm:rounded-3xl">
  <div class="p-5 sm:p-6">
    <div class="flex items-center justify-between gap-3">
      <h2 class="flex items-center gap-2 text-2xl font-bold"><Icon name="shopping-bag" class="size-6 text-indigo" />{d.order.title}</h2>
      <form method="dialog"><button class="grid size-11 place-items-center rounded-full bg-paper-2 hover:bg-line" aria-label={d.order.close}><Icon name="x" /></button></form>
    </div>
    <p class="mt-1 text-ink-soft">{d.orderHint}</p>
    <p data-empty class="mt-5 rounded-xl border border-dashed border-line px-4 py-6 text-center text-ink-soft">{d.order.empty}</p>
    <ul data-list class="mt-4 max-h-64 divide-y divide-line overflow-y-auto"></ul>
    <div class="mt-4 grid gap-3">
      <label class="grid gap-1 text-sm font-semibold">{d.order.name}
        <input data-name name="name" type="text" autocomplete="name" class="min-h-12 rounded-xl border border-line bg-white px-4 text-lg font-normal" /></label>
      <label class="grid gap-1 text-sm font-semibold">{d.order.village}
        <input data-village name="village" type="text" autocomplete="address-level3" class="min-h-12 rounded-xl border border-line bg-white px-4 text-lg font-normal" /></label>
    </div>
    <div class="mt-5 flex items-center gap-3">
      <button data-send class={`${btn} flex-1 bg-leaf text-white hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-40`}><Icon name="message-circle" />{d.order.send}</button>
      <button data-clear class="min-h-12 px-3 font-semibold text-ink-soft underline underline-offset-4 hover:text-brick">{d.order.clear}</button>
    </div>
  </div>
</dialog>

<script>
  // Live open/closed status in the shop's time zone (IST)
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const h = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date()));
  const isOpen = h >= Number(status.dataset.openH) && h < Number(status.dataset.closeH);
  status.querySelector('[data-status-text]')!.textContent = isOpen
    ? `${status.dataset.open} · ${status.dataset.until}` : `${status.dataset.closed} · ${status.dataset.opens}`;
  status.querySelector('[data-dot]')!.className = `size-2.5 rounded-full ${isOpen ? 'bg-green-400' : 'bg-stone-400'}`;

  // Category filter
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  filters.forEach((btn) => btn.addEventListener('click', () => {
    const c = btn.dataset.filter;
    document.querySelectorAll<HTMLElement>('[data-cat]').forEach((el) => (el.hidden = c !== 'all' && el.dataset.cat !== c));
    filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
  }));

  // Paint swatch → wall preview
  const wall = document.querySelector<HTMLElement>('[data-wall]')!;
  const wallName = document.querySelector('[data-wall-name]')!;
  const swatches = document.querySelectorAll<HTMLButtonElement>('[data-swatch]');
  swatches.forEach((s) => s.addEventListener('click', () => {
    wall.style.background = s.dataset.swatch!;
    wallName.textContent = s.dataset.name!;
    swatches.forEach((b) => b.setAttribute('aria-pressed', String(b === s)));
  }));

  // Order list → WhatsApp message (no backend, no cost)
  const dlg = document.getElementById('cart') as HTMLDialogElement;
  const cart = new Map<string, number>();
  const list = dlg.querySelector('[data-list]')!;
  const send = dlg.querySelector<HTMLButtonElement>('[data-send]')!;
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  const total = () => [...cart.values()].reduce((a, b) => a + b, 0);

  function render() {
    const n = total();
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      el.textContent = String(n);
      if (el.hasAttribute('data-badge')) el.hidden = n === 0;
    });
    document.querySelector<HTMLElement>('[data-cart-fab]')!.hidden = n === 0;
    (dlg.querySelector('[data-empty]') as HTMLElement).hidden = n > 0;
    send.disabled = n === 0;
    list.replaceChildren(...[...cart].map(([name, qty]) => {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 py-2.5';
      li.innerHTML = '<span class="flex-1 font-semibold leading-snug"></span>'
        + '<button data-d="-1" class="grid size-10 place-items-center rounded-full border border-line bg-white text-xl font-bold" aria-label="−1">−</button>'
        + '<span class="w-7 text-center text-lg font-bold tabular-nums"></span>'
        + '<button data-d="1" class="grid size-10 place-items-center rounded-full border border-line bg-white text-xl font-bold" aria-label="+1">+</button>';
      const [label, count] = li.querySelectorAll('span');
      label.textContent = name;
      count.textContent = String(qty);
      li.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
        const q = qty + Number(b.dataset.d);
        q > 0 ? cart.set(name, q) : cart.delete(name);
        render();
      }));
      return li;
    }));
  }

  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => b.addEventListener('click', () => {
    const name = b.dataset.add!;
    cart.set(name, (cart.get(name) ?? 0) + 1);
    const [plus, check] = b.querySelectorAll<HTMLElement>('[data-i]');
    plus.hidden = true; check.hidden = false;
    b.classList.remove('pop'); void b.offsetWidth; b.classList.add('pop');
    clearTimeout(Number(b.dataset.t));
    b.dataset.t = String(setTimeout(() => { plus.hidden = false; check.hidden = true; }, 1100));
    render();
    live.textContent = `${name} + 1 · ${total()} ${live.dataset.itemsLabel}`;
  }));
  document.querySelectorAll('[data-open-cart]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // tap on the backdrop closes
  dlg.querySelector('[data-clear]')!.addEventListener('click', () => { cart.clear(); render(); });
  send.addEventListener('click', () => {
    const v = (s: string) => (dlg.querySelector(s) as HTMLInputElement).value.trim();
    const lines = [dlg.dataset.msg, '', ...[...cart].map(([n, q]) => `• ${n} × ${q}`), ''];
    if (v('[data-name]')) lines.push(`${dlg.dataset.msgName}: ${v('[data-name]')}`);
    if (v('[data-village]')) lines.push(`${dlg.dataset.msgVillage}: ${v('[data-village]')}`);
    location.href = `https://wa.me/${dlg.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
  });
  render();
</script>
