---
// Cloudflare Pages serves this with a real 404 status; without it, unknown URLs returned the homepage as 200 (bad for Google).
import '../styles/global.css';
import { shop } from '../data/shop';
---
<!doctype html>
<html lang="hi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>पेज नहीं मिला | {shop.name}</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
  </head>
  <body class="grid min-h-screen place-items-center p-6 text-center font-sans">
    <main>
      <img src="/logo.svg" alt="" width="72" height="72" class="mx-auto h-18 w-18" />
      <h1 class="mt-4 text-3xl font-extrabold">यह पेज नहीं मिला</h1>
      <p class="mt-1 text-lg text-stone-600">Page not found</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-2xl bg-brand px-5 py-3 text-lg font-bold text-white">🏠 {shop.nameHi}</a>
        <a href={`tel:+91${shop.phones[0]}`} class="rounded-2xl bg-sky px-5 py-3 text-lg font-bold text-white">📞 {shop.phones[0]}</a>
      </div>
    </main>
  </body>
</html>
